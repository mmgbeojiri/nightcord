  <div id="myDropdown" class="dropdown-content hidden">
    <button id="darkModeButton" onclick="setDarkMode(!darkMode)">Dark Mode: Off</button>
    <button id="adminModeButton" onclick="setAdminPowers(!adminPowers)">Admin Mode: Off</button>
    <button onclick="window.location.href='./about.html'">About</button>
    <hr />
    <button onclick="getLink()">Get Server Link</button>
    <button onclick="changeLink()">Change Server Link</button>
    <button onclick="resetLink()">Reset Server Link</button>
  </div>
  </div>
  <!-- <button onClick = getData()>Click Here To Fetch Data</button> -->
</div>
<main>
<div id="channels">
  <button id="createChannel" onclick="channelCreate()"> + </button>
  <div id="buttonContainer">
            <div id="channel_1" onclick="changeActiveChannel('Tweets');" class="">
            <p>Tweets</p>
            <div class="channelEditButtons">
            <button onclick="event.stopPropagation(); channelEdit('Tweets', '1');">Edit</button>
            <button onclick="event.stopPropagation(); channelDelete('Tweets', '1');">X</button>
            </div>
            </div>
            
            <div id="channel_2" onclick="changeActiveChannel('OtherChannel');" class="">
            <p>OtherChannel</p>
            <div class="channelEditButtons">
            <button onclick="event.stopPropagation(); channelEdit('OtherChannel', '2');">Edit</button>
            <button onclick="event.stopPropagation(); channelDelete('OtherChannel', '2');">X</button>
            </div>
            </div>
            
            <div id="channel_3" onclick="changeActiveChannel('SomethingElse');" class="">
            <p>SomethingElse</p>
            <div class="channelEditButtons">
            <button onclick="event.stopPropagation(); channelEdit('SomethingElse', '3');">Edit</button>
            <button onclick="event.stopPropagation(); channelDelete('SomethingElse', '3');">X</button>
            </div>
            </div>
            
            <div id="channel_4" onclick="changeActiveChannel('InsaneChannel');" class="activeButton">
            <p>InsaneChannel</p>
            <div class="channelEditButtons">
            <button onclick="event.stopPropagation(); channelEdit('InsaneChannel', '4');">Edit</button>
            <button onclick="event.stopPropagation(); channelDelete('InsaneChannel', '4');">X</button>
            </div>
            </div>
            </div>
</div>
<div id="jsonContainer">
            <div class="message" id="message_64">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="copyData('I support polluting the water!')">copy</button>
                <button onclick="populateData('64')">edit</button>
                <button onclick="deleteData('64', 'I support polluting the water!')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>I support polluting the water!</p>
              <p class="editDisclaimer">(edited)</span>
              </div>
              <span>5/11/2026, 8:55:23 AM</span>
              </div>
            <div class="message" id="message_62">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="copyData('I love saying swear words!')">copy</button>
                <button onclick="populateData('62')">edit</button>
                <button onclick="deleteData('62', 'I love saying swear words!')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>I love saying swear words!</p>
              
              </div>
              <span>5/8/2026, 9:08:18 AM</span>
              </div>
            <div class="message" id="message_61">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="copyData('My social security number is 845-926-2005')">copy</button>
                <button onclick="populateData('61')">edit</button>
                <button onclick="deleteData('61', 'My social security number is 845-926-2005')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>My social security number is 845-926-2005</p>
              
              </div>
              <span>5/8/2026, 9:08:06 AM</span>
              </div><h1>InsaneChannel</h1></div>
</main>
<div>
  <h2 id="editing" style="display: none;">Editing Message.</h2>
  <form>
    <input class="input" type="text" id="nameInput" placeholder="Username">
    <input class="input" id="messageInput" placeholder="Enter your message" data-placeholder="Enter your message">
    <button type="button" onclick="
    sendData()">Send</button> 
    </form>
    </div>


</div>