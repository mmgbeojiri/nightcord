<div id="header">
  <h1>Nightcord</h1>
</div>
<main>
<div id="channels">
  <button id="createChannel" onclick="channelCreate()"> + </button>
  <div id="buttonContainer">
            <button id="channel_1" onclick="currentChannel = 'Tweets'; getData();" class="activeButton">
            Tweets
            </button>
            
            <button id="channel_2" onclick="currentChannel = 'OtherChannel'; getData();" class="">
            OtherChannel
            </button>
            </div>
</div>
<div id="jsonContainer">
            <div class="message active" id="54">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="populateData('54')">edit</button>
                <button onclick="deleteData('54')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>I understand the problem, the server updates the twitter.db and live server detects that.</p>
              
              </div>
              <span>4/16/2026, 9:12:20 AM</span>
              </div>
            <div class="message" id="53">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="populateData('53')">edit</button>
                <button onclick="deleteData('53')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>My liveserver extension has turned off the updating and editing of files.</p>
              <p class="editDisclaimer">(edited)</p>
              </div>
              <span>4/16/2026, 9:09:34 AM</span>
              </div>
            <div class="message" id="52">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="populateData('52')">edit</button>
                <button onclick="deleteData('52')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>e.preventDefault() is in sendData()</p>
              <p class="editDisclaimer">(edited)</p>
              </div>
              <span>4/16/2026, 9:00:58 AM</span>
              </div>
            
            <div class="message" id="2">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="populateData('2')">edit</button>
                <button onclick="deleteData('2')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>Oh HELL nah.</p>
              
              </div>
              <span>3/12/2026, 9:16:51 AM</span>
              </div>
            <div class="message" id="1">
              <div class="messageHeader">
                <h1>Elon Musk</h1>
                <div class="buttonContainer">
                <button onclick="populateData('1')">edit</button>
                <button onclick="deleteData('1')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>Hi guys!</p>
              
              </div>
              <span>3/12/2026, 9:05:22 AM</span>
              </div></div>
</main>
<div>
  <h2 id="editing" style="display: block;">Editing Message.</h2>
  <form>
    <input class="input" type="text" id="nameInput" placeholder="Username">
    <input class="input" id="messageInput" placeholder="Enter your message" data-placeholder="Enter your message">
    <button type="button" onclick="
    sendData()">Send</button> 
    </form>
    </div>


