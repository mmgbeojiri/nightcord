<div id="jsonContainer">
            <div class="message" id="54">
              <div class="messageHeader">
                <h1>Michael</h1>
                <div class="buttonContainer">
                <button onclick="copyData('I understand the problem, the server updates the twitter.db and live server detects that.')">copy</button>
                <button onclick="populateData('54')">edit</button>
                <button onclick="deleteData('54')">delete</button>
                </div>
              </div>
              <div class="messageContent">
              <p>I understand the problem, the server updates the twitter.db and live server detects that.</p>
              
              </div>
              <span>4/16/2026, 9:12:20 AM</span>
              </div>
