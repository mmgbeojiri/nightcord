@import "tailwindcss";
@custom-variant dark (&:where(.dark, .dark *));
@theme {
  /* ... */
}

* {
  @apply duration-100 box-border
}

#header {
  @apply dark:bg-slate-800 bg-slate-50 flex flex-row items-center border-b-2 border-slate-200 dark:border-slate-700 h-[10vh] justify-between px-5;
}

#header h1 {
 @apply dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-slate-300 text-xl font-bold p-2 text-slate-500 hover:bg-white hover:text-slate-400 rounded-xl;
}
#settings #myDropdown {
  @apply absolute right-5 z-10 mt-2 w-48 rounded-lg border border-slate-100 dark:border-slate-700 bg-white dark:bg-slate-800 text-left text-sm shadow-lg p-1;
}

#svgButton {
  @apply text-xl font-bold p-2 text-slate-500 hover:bg-white dark:hover:bg-slate-900 hover:text-slate-400 rounded-xl active:bg-white;
}

#myDropdown button {
  @apply flex w-full items-center rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:bg-slate-800 bg-white border-none font-medium dark:hover:bg-slate-700 dark:text-slate-400;
}

#svgButton.active {
  @apply bg-white dark:bg-slate-900;
}

.hidden {
  @apply hidden;
}


button {
  @apply bg-blue-400 border-blue-500 dark:bg-slate-800 dark:text-blue-500 border hover:bg-blue-200 dark:hover:bg-blue-900 px-3 text-white font-bold rounded items-center
}

#jsonContainer {
  @apply flex flex-col-reverse gap-1 overflow-y-scroll scroll-smooth h-[80vh] py-3 bg-slate-50 dark:bg-slate-800 w-full
}

#jsonContainer > h1 {
  @apply text-4xl p-5 mx-5 border-2 rounded-xl  border-slate-300 font-bold bg-slate-100 text-slate-500 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-500
}

.message {
  @apply   hover:bg-white dark:hover:bg-slate-700 rounded-xl flex flex-col p-5 mx-5 
}

.message h1 {
  @apply text-xl text-slate-500 dark:text-slate-500 font-bold m-0
}
.messageContent {
  @apply flex flex-row gap-1 items-baseline
}
.message p {
  @apply text-slate-800 dark:text-slate-400 text-lg
}
.message.active {
  @apply !bg-white dark:!bg-slate-700
}
.editDisclaimer {
  @apply !text-slate-400 !text-sm items-baseline dark:!text-slate-600
}

.message span {
  @apply text-sm text-slate-400 dark:text-slate-500
}

form {
  @apply flex flex-row mx-auto gap-1 p-5 bg-slate-50 dark:bg-slate-800 border-t-2 border-slate-100 dark:border-slate-700 h-[10vh]
}

form * {
  @apply h-[2.75rem] my-auto
}
.input {
   @apply  border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-300 border rounded p-3 min-w-0 overflow-y-auto leading-[1] inline-block
}

#nameInput {
  @apply flex-[2]! 
}
#messageInput {
@apply flex-[10]
}


form button {
  @apply flex-[1]! min-w-0
}

.messageHeader {
  @apply  flex flex-row justify-between
}

#buttonContainer > div {
  @apply px-3  font-bold rounded items-center bg-slate-100  text-slate-300 hover:bg-slate-50 hover:text-slate-400 w-full text-left border-none flex flex-row justify-between w-full mb-1 dark:bg-slate-900 dark:text-slate-800 dark:hover:bg-slate-800 dark:hover:text-slate-500 min-h-9
}

.channelEditButtons button {
  @apply !bg-slate-50  text-slate-500 border-slate-300 my-1 dark:!bg-slate-900 dark:border-slate-600 ; 
}

#buttonContainer p {
  @apply flex-1 overflow-hidden overflow-ellipsis;
}
.channelEditButtons {
  @apply  flex justify-center gap-1 flex-1
}
.buttonContainer button {
  @apply bg-slate-300 border-slate-400 text-slate-50 hover:bg-slate-200 dark:bg-slate-800 dark:border-slate-600 dark:hover:bg-slate-700
}

#editing {
  @apply absolute mx-5 text-xs my-1 text-slate-400 dark:text-slate-500
}

#channels {
  @apply hidden lg:flex  flex-col px-3 bg-slate-100 dark:bg-slate-900 py-3 gap-1 min-w-60
}
main {
  @apply flex flex-row
}

#channels .activeButton {
  @apply border-2 border-slate-600 bg-slate-50 text-slate-500 dark:bg-slate-700 dark:text-slate-400
}

#channels #createChannel {
  @apply bg-slate-400 border border-slate-500   text-center hover:bg-slate-300 dark:bg-slate-900 dark:border-slate-600 dark:hover:bg-slate-800 dark:text-slate-500
}